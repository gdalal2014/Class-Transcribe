<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The use cases and the ports: a plain target, since nothing here uses Windows (architecture 1.2). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClassScribe.Application</RootNamespace>
  </PropertyGroup>

  <!-- A file that reaches for the network here writes its own using line, so that it is visible (architecture 1.4). -->
  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassScribe.Core\ClassScribe.Core.csproj" />
  </ItemGroup>

</Project>
