{
  "Recording": {
    "OutputFolder": "%USERPROFILE%\\ClassScribe",
    "Device": "",
    "App": "",
    "FlushSeconds": 5,
    "SilenceWarningSeconds": 60,
    "StatusIntervalSeconds": 60,
    "MaxSegmentMegabytes": 1500,
    "KeepUploadFile": false,
    "OpenFolderWhenDone": true,
    "OpenTranscriptWhenDone": true,
    "KeepScreenOn": "OnBattery",
    "SeparateProcess": true,
    "ReopenWindow": "OnCloseAndProblems",
    "BlockShutdown": true,
    "ContinueWithinMinutes": 60,
    "StopAfterHours": 9
  },
  "ElevenLabs": {
    "ModelId": "scribe_v2",
    "LanguageCode": "",
    "TagAudioEvents": false,
    "NoVerbatim": false,
    "KeytermsFile": "keyterms.txt",
    "TimeoutMinutes": 60,
    "SlowestUploadMbps": 1,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 5
  },
  "Transcript": {
    "IncludeTimestamps": true,
    "ParagraphPauseSeconds": 2.0,
    "MaxParagraphCharacters": 900
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "plain"
    }
  }
}
