<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows' own target, for the camera's WinRT API (MediaCapture and the device lists): Windows 10 version 2004 or later.
         NAudio still takes its netstandard2.0 library; trimming and Native AOT stay off, since NAudio and the WinRT projection
         reach Windows through COM. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClassScribe</RootNamespace>
    <AssemblyName>ClassScribe</AssemblyName>
    <Version>0.4.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The compiler then reports a public type or member without an XML summary (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The summaries are for reading the code: ClassScribe.xml is not published next to the exe. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.3.0" />
    <!-- Windows' data protection (DPAPI), which keeps the Google Drive sign-in encrypted for the Windows account. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- The command line's parser. ClassScribe keeps its own exit codes and its own Ctrl+C: see CommandLineTree. -->
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
