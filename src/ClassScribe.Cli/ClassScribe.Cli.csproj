<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The app's own target: it composes Infrastructure, which needs Windows (architecture 1.2). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ClassScribe.Cli</RootNamespace>
    <!-- The exe keeps its name, ClassScribe.exe and ClassScribe.dll, which the recorder and the camera process start again (architecture 1.3, 5.4). -->
    <AssemblyName>ClassScribe</AssemblyName>
    <!-- The three other projects' XML files are not published either. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- The command line's parser. ClassScribe keeps its own exit codes and its own Ctrl+C: see CommandLineTree. -->
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassScribe.Infrastructure\ClassScribe.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
